load(
    "@rules_rust//rust:defs.bzl",
    "rust_doc",
    "rust_doc_test",
    "rust_library",
    "rust_test",
    "rust_test_suite",
)

rust_library(
    name = "nativelink-fetch",
    srcs = [
        "src/archive_expander.rs",
        "src/background_fetcher.rs",
        "src/fetcher.rs",
        "src/fetcher_factory.rs",
        "src/lib.rs",
        "src/metadata_cache.rs",
        "src/remote_asset_proto.rs",
        "src/spill.rs",
        "src/tree_hash/h1.rs",
        "src/tree_hash/mod.rs",
        "src/tree_hash/nar.rs",
        "src/url_fetcher.rs",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//nativelink-config",
        "//nativelink-error",
        "//nativelink-proto",
        "//nativelink-store",
        "//nativelink-util",
        "@crates//:astral-tokio-tar",
        "@crates//:async-compression",
        "@crates//:base64",
        "@crates//:bytes",
        "@crates//:crc32fast",
        "@crates//:futures",
        "@crates//:parking_lot",
        "@crates//:prost",
        "@crates//:prost-types",
        "@crates//:reqwest",
        "@crates//:rustls",
        "@crates//:sha2",
        "@crates//:tempfile",
        "@crates//:tokio",
        "@crates//:tokio-util",
        "@crates//:tonic",
        "@crates//:tracing",
        "@crates//:zip",
    ],
)

rust_test_suite(
    name = "integration",
    timeout = "short",
    srcs = [
        "tests/archive_expander_test.rs",
        "tests/background_fetcher_test.rs",
        "tests/h1_test.rs",
        "tests/metadata_cache_test.rs",
        "tests/nar_test.rs",
        "tests/url_fetcher_test.rs",
    ],
    proc_macro_deps = [
        "//nativelink-macro",
    ],
    shared_srcs = ["tests/support/mod.rs"],
    deps = [
        "//nativelink-config",
        "//nativelink-error",
        "//nativelink-fetch",
        "//nativelink-proto",
        "//nativelink-store",
        "//nativelink-util",
        "@crates//:bytes",
        "@crates//:crc32fast",
        "@crates//:flate2",
        "@crates//:futures",
        "@crates//:parking_lot",
        "@crates//:pretty_assertions",
        "@crates//:prost",
        "@crates//:sha2",
        "@crates//:tar",
        "@crates//:tempfile",
        "@crates//:tokio",
        "@crates//:tokio-util",
        "@crates//:tonic",
        "@crates//:tracing",
        "@crates//:tracing-test",
        "@crates//:zip",
    ],
)

rust_test(
    name = "unit_test",
    timeout = "short",
    crate = ":nativelink-fetch",
)

rust_doc(
    name = "docs",
    crate = ":nativelink-fetch",
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "doc_test",
    timeout = "short",
    crate = ":nativelink-fetch",
)
