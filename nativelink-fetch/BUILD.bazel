load(
    "@rules_rust//rust:defs.bzl",
    "rust_doc",
    "rust_doc_test",
    "rust_library",
    "rust_test",
    "rust_test_suite",
)

rust_library(
    name = "nativelink-fetch",
    srcs = [
        "src/background_fetcher.rs",
        "src/fetcher.rs",
        "src/lib.rs",
        "src/metadata_cache.rs",
        "src/remote_asset_proto.rs",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//nativelink-error",
        "//nativelink-proto",
        "//nativelink-store",
        "//nativelink-util",
        "@crates//:bytes",
        "@crates//:parking_lot",
        "@crates//:prost",
        "@crates//:prost-types",
        "@crates//:reqwest",
        "@crates//:tokio",
        "@crates//:tonic",
        "@crates//:tracing",
    ],
)

rust_test_suite(
    name = "integration",
    timeout = "short",
    srcs = [
        "tests/background_fetcher_test.rs",
        "tests/metadata_cache_test.rs",
    ],
    proc_macro_deps = [
        "//nativelink-macro",
    ],
    deps = [
        "//nativelink-config",
        "//nativelink-error",
        "//nativelink-fetch",
        "//nativelink-proto",
        "//nativelink-store",
        "//nativelink-util",
        "@crates//:parking_lot",
        "@crates//:prost",
        "@crates//:tokio",
        "@crates//:tonic",
        "@crates//:tracing",
        "@crates//:tracing-test",
    ],
)

rust_test(
    name = "unit_test",
    timeout = "short",
    crate = ":nativelink-fetch",
)

rust_doc(
    name = "docs",
    crate = ":nativelink-fetch",
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "doc_test",
    timeout = "short",
    crate = ":nativelink-fetch",
)
