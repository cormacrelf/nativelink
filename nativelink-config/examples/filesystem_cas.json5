// This configuration will place objects in various folders in
// `/tmp/nativelink/data`. It will store all data on disk and
// allows for restarts of the underlying service. It is optimized
// so objects are compressed, deduplicated and uses some in-memory
// optimizations for certain hot paths.
{
  stores: [
    {
      name: "FS_CONTENT_STORE",
      compression: {
        compression_algorithm: {
          lz4: {},
        },
        backend: {
          filesystem: {
            content_path: "/tmp/nativelink/data/content_path-cas",
            temp_path: "/tmp/nativelink/data/tmp_path-cas",
            eviction_policy: {
              // 2gb.
              max_bytes: 2000000000,
            },
          },
        },
      },
    },
    {
      name: "CAS_MAIN_STORE",
      verify: {
        backend: {
          // Because we are using a dedup store, we can bypass small objects
          // and put those objects directly into the content store without
          // having to be indexed. This greatly improves performance of serving
          // general build content, since many objects are quite small and by
          // putting this size distinguish store in place will prevent 1+ index
          // read/write per small object request.
          size_partitioning: {
            size: 262144, // 256k.
            lower_store: {
              ref_store: {
                name: "FS_CONTENT_STORE",
              },
            },
            upper_store: {
              dedup: {
                index_store: {
                  // Since our index store is queried so much, we use a fast_slow
                  // store so it will keep in memory objects that are accessed
                  // frequently before going to disk.
                  // Note: indexes are generally quite small, but accessed frequently.
                  fast_slow: {
                    fast: {
                      memory: {
                        eviction_policy: {
                          // 10mb.
                          max_bytes: 10000000,
                        },
                      },
                    },
                    slow: {
                      filesystem: {
                        content_path: "/tmp/nativelink/data/content_path-index",
                        temp_path: "/tmp/nativelink/data/tmp_path-index",
                        eviction_policy: {
                          // 500mb.
                          max_bytes: 500000000,
                        },
                      },
                    },
                  },
                },
                content_store: {
                  ref_store: {
                    name: "FS_CONTENT_STORE",
                  },
                },
              },
            },
          },
        },
        verify_size: true,
        verify_hash: true,
      },
    },
    {
      name: "AC_MAIN_STORE",
      filesystem: {
        content_path: "/tmp/nativelink/data/content_path-ac",
        temp_path: "/tmp/nativelink/data/tmp_path-ac",
        eviction_policy: {
          // 500mb.
          max_bytes: 500000000,
        },
      },
    },
    {
      // Remote Asset metadata (fetched URI + qualifiers -> CAS digest), stored
      // as ordinary Action Cache entries and used by the `fetch` service. It
      // shares AC_MAIN_STORE: the keys are digests of a synthetic Action whose
      // command is distinctive, so they cannot collide with real actions. The
      // `completeness_checking` wrapper makes an entry read as a miss once any
      // of its content has left the CAS, so the asset is fetched again rather
      // than a dangling digest being served.
      name: "FETCH_METADATA_STORE",
      completeness_checking: {
        backend: {
          ref_store: {
            name: "AC_MAIN_STORE",
          },
        },
        cas_store: {
          ref_store: {
            name: "CAS_MAIN_STORE",
          },
        },
      },
    },
  ],

  // Fetchers compose as a chain referenced by name: `FETCH_CACHE` ->
  // `FETCH_URL`. A fetcher can only name fetchers listed before it.
  fetchers: [
    {
      // Leaf: downloads content over HTTP(S) and stores it in the CAS.
      name: "FETCH_URL",
      url: {
        cas_store: "CAS_MAIN_STORE",

        // Should be on the same volume as the CAS content_path so the fetched
        // temp file can be moved into the store without a copy.
        temp_path: "/tmp/nativelink/data/tmp_path-fetch",

        // Reject any single download larger than 256 GiB.
        max_size_bytes: 274877906944,
      },
    },
    {
      // Runs fetches in the background, joining concurrent identical ones and
      // keeping a fetch running past the client's RPC deadline so a retry can
      // reuse it, and writes the fetched asset's URI+qualifiers -> digest
      // metadata so future Fetch calls hit.
      name: "FETCH_CACHE",
      cache: {
        fetcher: "FETCH_URL",
        fetch_store: "FETCH_METADATA_STORE",
        cas_store: "CAS_MAIN_STORE",
        max_concurrent_fetches: 8,
      },
    },
  ],
  schedulers: [
    {
      name: "MAIN_SCHEDULER",
      simple: {
        supported_platform_properties: {
          cpu_count: "minimum",
          memory_kb: "minimum",
          network_kbps: "minimum",
          disk_read_iops: "minimum",
          disk_read_bps: "minimum",
          disk_write_iops: "minimum",
          disk_write_bps: "minimum",
          shm_size: "minimum",
          gpu_count: "minimum",
          gpu_model: "exact",
          cpu_vendor: "exact",
          cpu_arch: "exact",
          cpu_model: "exact",
          kernel_version: "exact",
          docker_image: "priority",
          "lre-rs": "priority",
          ISA: "exact",
        },
      },
    },
  ],
  servers: [
    {
      listener: {
        http: {
          socket_address: "0.0.0.0:50051",
        },
      },
      services: {
        cas: [
          {
            instance_name: "main",
            cas_store: "CAS_MAIN_STORE",
          },
        ],
        ac: [
          {
            instance_name: "main",
            ac_store: "AC_MAIN_STORE",
          },
        ],
        execution: [
          {
            instance_name: "main",
            cas_store: "CAS_MAIN_STORE",
            scheduler: "MAIN_SCHEDULER",
          },
        ],
        capabilities: [
          {
            instance_name: "main",
            remote_execution: {
              scheduler: "MAIN_SCHEDULER",
            },
          },
        ],
        bytestream: {
          cas_stores: {
            main: "CAS_MAIN_STORE",
          },
        },

        // Remote Asset API fetch service. `fetch_store` is read to serve
        // previously fetched/pushed assets; `fetcher` is the chain used to
        // actively download on a miss (omit `fetcher` for lookup-only).
        fetch: [
          {
            instance_name: "main",
            fetch_store: "FETCH_METADATA_STORE",
            fetcher: "FETCH_CACHE",
          },
        ],
      },
    },
    {
      listener: {
        http: {
          socket_address: "0.0.0.0:50061",
        },
      },
      services: {
        // Note: This should be served on a different port, because it has
        // a different permission set than the other services.
        // In other words, this service is a backend api. The ones above
        // are a frontend api.
        worker_api: {
          scheduler: "MAIN_SCHEDULER",
        },
        health: {},
      },
    },
  ],
}
